# Konfiguration der App. Alle Werte in einer Datei — keine geteilte Stack-Env.
# Beim Installieren über die Deployer-Kachel schreibt efa one aus dieser Datei die
# .env der App: die Plattform-Werte unten setzt der Deployer selbst, App-eigene
# Werte übernimmt er von hier (bzw. aus den Overrides beim Deploy).
# Werte ohne sinnvollen Default, ohne die die App nicht startet, mit einer Zeile
# `# @pflicht` direkt darüber markieren — dann bricht der Deploy ab, statt dass
# die App still kaputt startet.

# ── Plattform-Werte (setzt der Deployer — lokal von Hand eintragen) ──────────
# Base64-encoded RSA public key (RS256). Apps verifizieren damit die efa-one-JWTs.
JWT_PUBLIC_KEY=

# Per-App-Service-Identität gegenüber dem Kernel (X-Service-Auth-Key). Erzeugt der
# Deployer bei der Installation; im Kernel liegt nur ihr Hash.
SERVICE_AUTH_KEY=

# URLs zum Converge Kernel-Backend (intern via Docker-DNS).
CONVERGE_REGISTRY_URL=http://converge-backend:3001
CONVERGE_GATEWAY_URL=http://converge-backend:3001

# Optionale Stack-Endpoints (leer = silent no-op in den template-core-Clients).
AUDIT_URL=
REPORTING_URL=
NOTIFICATION_URL=

# Runtime-Modus: `development` aktiviert /dev/token, `production` deaktiviert es.
ENVIRONMENT=development
# Cookie-Secure-Flag (HTTPS only). Lokal `false`, Prod `true`.
COOKIE_SECURE=false

# ── App-Identität – pro App eindeutig setzen ─────────────────────────────────
APP_NAME=my-app
SERVICE_KEY=template_app
FRONTEND_PORT=6800
APP_SESSION_COOKIE_NAME=template_app_session

# Image-Pfad in deiner Registry (ohne -backend/-frontend-Suffix und ohne :tag).
# Mit dem mitgelieferten Build-Workflow: ghcr.io/<github-org lowercase>/<repo-name, '-' → '_'>
IMAGE_REPOSITORY=ghcr.io/your-org/template_app
# IMAGE_TAG=latest    # optional, Default "latest" — beim Deploy setzt efa one die gewählte Version

# ── Datenbank-Stack-Variante ─────────────────────────────────────────────────
# postgres  → Standard-Stack (docker-compose.yml): 3 Container, eigene PostgreSQL.
#             Pflicht für Stammdaten-/komplexe Apps. Default.
# sqlite    → Single-Container-Stack (docker-compose.single.yml): 1 Container,
#             SQLite-Datei im Volume. Für einfache Apps. SERVE_STATIC=true +
#             SQLITE_PATH werden dort gesetzt; APP_DB_* unten entfallen dann.
# Die Compose-Datei setzt DB_DRIVER passend — hier nur zur Doku.
DB_DRIVER=postgres

# ── App-eigene Datenbank (nur DB_DRIVER=postgres) ────────────────────────────
APP_DB_NAME=appdb
APP_DB_USER=appuser
APP_DB_PASSWORD=changeme

# Eigenes Session-Secret (HS256). Generieren mit: openssl rand -hex 32
APP_SESSION_SECRET=
