# Konfiguration der App. Alle Werte in einer Datei — keine geteilte Stack-Env.
# In Produktion erzeugt `system/converge-kernel/scripts/deploy.sh` diese Datei
# beim Bootstrap/Update aus /opt/converge/.secrets neu (App-spezifische Werte
# bleiben dabei idempotent erhalten).

# ── Stack-Werte (in jeder App identisch — aus /opt/converge/.secrets) ─────────
# Base64-encoded RSA public key (RS256). Apps verifizieren damit Converge-JWTs.
# Lokale Entwicklung: erzeugen via system/converge-kernel/scripts/generate-jwt-keys.sh
JWT_PUBLIC_KEY=

# Shared Secret für Service-zu-Service-Calls (X-Registry-Key Header).
# Muss mit dem Wert im Kernel übereinstimmen.
REGISTRY_API_KEY=

# URLs zum Converge Kernel-Backend (intern via Docker-DNS).
CONVERGE_REGISTRY_URL=http://converge-backend:3001
CONVERGE_GATEWAY_URL=http://converge-backend:3001

# Optionale Stack-Endpoints (leer = silent no-op in den template-core-Clients).
AUDIT_URL=
REPORTING_URL=
NOTIFICATION_URL=

# Runtime-Modus: `development` aktiviert /dev/token, `production` deaktiviert es.
ENVIRONMENT=development
# Cookie-Secure-Flag (HTTPS only). Lokal `false`, Prod `true`.
COOKIE_SECURE=false

# ── App-Identität – pro App eindeutig setzen ─────────────────────────────────
APP_NAME=my-app
SERVICE_KEY=template_app
FRONTEND_PORT=6800
APP_SESSION_COOKIE_NAME=template_app_session

# GHCR-Image-Pfad (ohne -backend/-frontend-Suffix und ohne :tag).
# Entspricht 1:1 dem CI-Output: ghcr.io/<repository_owner lowercase>/<repository_name, '-' → '_'>
# Die Org variiert pro Partner/Kunde — anpassen, bevor das erste Tag gepusht wird.
IMAGE_REPOSITORY=ghcr.io/d-w-it-consulting/template_app
# IMAGE_TAG=latest    # optional, Default "latest" — CI setzt den konkreten v*-Tag

# ── Datenbank-Stack-Variante ─────────────────────────────────────────────────
# postgres  → Standard-Stack (docker-compose.yml): 3 Container, eigene PostgreSQL.
#             Pflicht für Stammdaten-/komplexe Apps. Default.
# sqlite    → Single-Container-Stack (docker-compose.single.yml): 1 Container,
#             SQLite-Datei im Volume. Für einfache Apps. SERVE_STATIC=true +
#             SQLITE_PATH werden dort gesetzt; APP_DB_* unten entfallen dann.
# Die Compose-Datei setzt DB_DRIVER passend — hier nur zur Doku.
DB_DRIVER=postgres

# ── App-eigene Datenbank (nur DB_DRIVER=postgres) ────────────────────────────
APP_DB_NAME=appdb
APP_DB_USER=appuser
APP_DB_PASSWORD=changeme

# Eigenes Session-Secret (HS256). Generieren mit: openssl rand -hex 32
APP_SESSION_SECRET=
