{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "rootDir": "src/frontend",
    "outDir": "frontend",
    "removeComments": false
  },
  "include": ["src/frontend/**/*"]
}
