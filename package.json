{
  "name": "@efa-one/sdk",
  "version": "1.15.1",
  "description": "Offizielles SDK für efa-one-Apps: Auth/Session, Service-Discovery, Gateway-Client, Audit/Reporting/Mail/Notifications, Permission- und Capability-Registrierung sowie das Frontend-IPC-/i18n-Toolkit.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "exports": {
    "./backend": {
      "types": "./backend/index.d.ts",
      "require": "./backend/index.js",
      "default": "./backend/index.js"
    },
    "./backend/*": {
      "types": "./backend/*.d.ts",
      "require": "./backend/*.js",
      "default": "./backend/*.js"
    },
    "./frontend": {
      "types": "./frontend/index.d.ts",
      "import": "./frontend/index.js",
      "default": "./frontend/index.js"
    },
    "./frontend/ui": {
      "types": "./frontend/ui/index.d.ts",
      "import": "./frontend/ui/index.js",
      "default": "./frontend/ui/index.js"
    },
    "./frontend/ui/styles.css": "./frontend/ui/styles.css",
    "./frontend/*": {
      "types": "./frontend/*.d.ts",
      "import": "./frontend/*.js",
      "default": "./frontend/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "backend",
    "frontend",
    "NOTICE"
  ],
  "scripts": {
    "clean": "rm -rf backend frontend",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "tsc -p tsconfig.frontend.json && node scripts/postbuild-frontend.mjs",
    "build": "npm run clean && npm run build:backend && npm run build:frontend",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.frontend.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": ">=1",
    "@radix-ui/react-dropdown-menu": ">=1",
    "@radix-ui/react-tooltip": ">=1",
    "express": ">=4",
    "i18next": ">=23",
    "i18next-http-backend": ">=2",
    "jsonwebtoken": ">=9",
    "lucide-react": ">=0.400.0",
    "pg": ">=8",
    "react": ">=18",
    "react-dom": ">=18",
    "react-i18next": ">=13"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "jsonwebtoken": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "i18next-http-backend": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "@radix-ui/react-dialog": {
      "optional": true
    },
    "@radix-ui/react-dropdown-menu": {
      "optional": true
    },
    "@radix-ui/react-tooltip": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cookie-parser": "^1.4.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^4.19.2",
    "i18next": "^23.11.0",
    "i18next-http-backend": "^2.7.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.577.0",
    "pg": "^8.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.5.0",
    "supertest": "^7.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
